PORT=3001
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
DB_SYNCHRONIZE=false
DB_SSL=false
DATABASE_URL=postgresql://user:pass@localhost:5432/conectau
ADMIN_EMAIL=admin@conectau.test
ADMIN_PASSWORD=cambia-esto

# Correo de bienvenida al crear una cuenta. Sin SMTP_HOST no se envía nada (solo queda un aviso en el log).
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Conecta U <no-reply@conectau.test>

# IA (análisis de proyectos y matchmaking). Con AI_PROVIDER=fake todo funciona sin red ni API key.
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
AI_TIMEOUT_MS=30000
MATCH_WEIGHTS=0.5,0.2,0.15,0.15
MATCH_TOP_N=10
# Certificados de experiencia (RT16). En desarrollo se guardan en disco (STORAGE_DRIVER=local);
# en producción se exige un bucket privado compatible con S3 (AWS S3, Cloudflare R2, Supabase
# Storage o MinIO). Para R2: S3_REGION=auto y S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Correo con Gmail (recuperación de contraseña, bienvenida y convocatorias). Dos opciones:
# 1) SMTP de Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<cuenta>@gmail.com,
#    SMTP_PASS=<contraseña de aplicación de 16 caracteres> (requiere verificación en dos pasos).
# 2) API de Gmail por HTTPS (si el servidor bloquea los puertos SMTP): MAIL_PROVIDER=gmail-api y
#    las credenciales OAuth de la cuenta con el alcance https://www.googleapis.com/auth/gmail.send.
MAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Detrás de un proxy (Render) para que el límite por IP use la IP real. En producción vale 1.
TRUST_PROXY=
