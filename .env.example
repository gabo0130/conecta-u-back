PORT=3001
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
DB_SYNCHRONIZE=false
DB_SSL=false
DATABASE_URL=postgresql://user:pass@localhost:5432/conectau
ADMIN_EMAIL=admin@conectau.test
ADMIN_PASSWORD=cambia-esto

# Correo de bienvenida al crear una cuenta. Sin SMTP_HOST no se envía nada (solo queda un aviso en el log).
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Conecta U <no-reply@conectau.test>

# IA (análisis de proyectos y matchmaking). Con AI_PROVIDER=fake todo funciona sin red ni API key.
# claude: Claude analiza y Gemini es el respaldo y da los embeddings (exige las dos claves).
# gemini: solo Gemini. fake: sin red.
# Producción (decisión del 19/11/2026): AI_PROVIDER=claude, GEMINI_MODEL=gemini-3.5-flash-lite y
# GEMINI_FALLBACK_MODEL vacío. gemini-3.8-flash tardaba 75–180 s y agotó la cuota en pocas llamadas.
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Máximo que se espera a Claude antes de pasar a Gemini.
CLAUDE_TIMEOUT_MS=25000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Respaldo si el principal agota la cuota, responde 5xx o no responde a tiempo (vacío = sin respaldo).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Presupuesto total de un análisis en segundo plano (el front no espera la respuesta: consulta).
AI_TIMEOUT_MS=90000
# Máximo que se espera al modelo principal antes de pasar al respaldo (con respaldo configurado).
GEMINI_PRIMARY_TIMEOUT_MS=25000
MATCH_WEIGHTS=0.5,0.2,0.15,0.15
MATCH_TOP_N=10