{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "\\.e2e\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/support/global-setup.ts",
  "setupFiles": ["<rootDir>/support/test-env.ts"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
