              "path": ["auth", "login"]
            },
            "description": "Usa la cuenta admin creada por el seed (ADMIN_EMAIL/ADMIN_PASSWORD, o admin@conectau.test / Test1234! por defecto). Corre esta request antes de probar Users, Access o Import."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
