              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Requiere JWT válido. No invalida el token del lado del servidor (es stateless); solo confirma la operación."
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Perfil del usuario autenticado (según el accessToken activo), incluyendo su menú por rol."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Collaborators (Colaborador/Líder)",
      "description": "RF3-RF6. Requiere estar logueado como COLABORADOR o LIDER (corre Auth > Login - Colaborador, Login - Líder o Login - Líder sin perfil primero). Todas las rutas operan sobre el perfil del usuario autenticado (/me).",
      "item": [
        {
          "name": "Create My Profile (LIDER) (RF3)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Mario\",\n  \"lastName\": \"Quintero\",\n  \"personType\": \"DOCENTE\",\n  \"programId\": \"{{programId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/collaborators/me",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators", "me"]
            },
            "description": "Solo para un LIDER que todavía no tiene perfil técnico (corre Login - Líder sin perfil antes). 409 si ya tienes uno, o si el correo ya está vinculado a otra cuenta."
          },
          "response": []
        },
        {
          "name": "Get My Profile (RF3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collaborators/me",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators", "me"]
            },
            "description": "Devuelve datos generales + skills (con nivel/meses/último uso) + experiencia (con durationMonths calculado) + disponibilidad."
          },
          "response": []
        },
        {
          "name": "Update My Profile (RF3)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Estudiante de últimos semestres, enfocado en frontend.\",\n  \"researchGroup\": \"Semillero de Software · Grupo A\",\n  \"profileUrl\": \"https://github.com/ana\",\n  \"dataConsent\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/collaborators/me",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators", "me"]
            }
          },
          "response": []
        },
        {
          "name": "List My Skills (RF4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collaborators/me/skills",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators", "me", "skills"]
            }
          },
          "response": []
        },
        {
          "name": "Add Skill (RF4)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillId\": \"{{skillId}}\",\n  \"level\": \"INTERMEDIO\",\n  \"experienceMonths\": 12,\n  \"lastUsedYear\": 2026\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/collaborators/me/skills",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators", "me", "skills"]
            },
            "description": "Corre Catalogs > Search Skills antes (necesita skillId del catálogo). level debe ser BASICO, INTERMEDIO, AVANZADO o EXPERTO."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Add Skill responde 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('collaboratorSkillId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Skill (RF4)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillId\": \"{{skillId}}\",\n  \"level\": \"AVANZADO\",\n  \"experienceMonths\": 18,\n  \"lastUsedYear\": 2026\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/collaborators/me/skills/{{collaboratorSkillId}}",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators", "me", "skills", "{{collaboratorSkillId}}"]
            },
            "description": "collaboratorSkillId es el id de la entrada del perfil (lo guarda Add Skill), no el id del catálogo."
          },
          "response": []
        },
        {
          "name": "Delete Skill (RF4)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collaborators/me/skills/{{collaboratorSkillId}}",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators", "me", "skills", "{{collaboratorSkillId}}"]
            },
            "description": "204 sin body. Corre esto al final, después de Update Skill."
          },
          "response": []
        },
        {
          "name": "Create Experience (RF5)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
